# Production Database Connection (PostgreSQL - Neon / Supabase / Railway / RDS)
DATABASE_URL="postgresql://user:password@ep-cloud-db.region.aws.neon.tech/cadpoint_crm?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-cloud-db.region.aws.neon.tech/cadpoint_crm?sslmode=require"

# JWT Secret Key
JWT_SECRET="production-super-secret-jwt-key-min-32-chars"
PORT=5001

# Production Environment
NODE_ENV="production"
CLIENT_URL="https://crm.yourdomain.com,https://yourproject.vercel.app"

# Production Cloud Object Storage (Supabase Storage / AWS S3)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="cadpoint-crm-production"

# Alternative S3 Configuration (if using AWS S3)
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="cadpoint-crm-production"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# WhatsApp Meta Cloud API (Optional)
WHATSAPP_ENABLED="false"
WHATSAPP_API_URL="https://graph.facebook.com/v18.0/"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
