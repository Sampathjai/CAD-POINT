generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  COUNSELLOR
  TRAINER
  ACCOUNTS
  RECEPTIONIST
}

enum LeadStatus {
  NEW
  CONTACTED
  FOLLOW_UP
  INTERESTED
  DEMO_SCHEDULED
  NEGOTIATION
  ADMISSION
  NOT_INTERESTED
  LOST
  INVALID
}

enum FollowUpType {
  CALL
  WHATSAPP
  SMS
  EMAIL
  VISIT
  DEMO
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
  RESCHEDULED
}

enum AdmissionStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  DROPPED
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CHEQUE
  ONLINE
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum CertificateStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ISSUED
  REVOKED
  PENDING
}

enum NotificationType {
  FOLLOW_UP
  FEE_DUE
  BATCH_START
  CERTIFICATE
  SYSTEM
}

model Branch {
  id          String      @id @default(uuid())
  code        String      @unique
  name        String
  address     String?
  phone       String?
  isActive    Boolean     @default(true)
  users       User[]
  leads       Lead[]
  students    Student[]
  admissions  Admission[]
  payments    Payment[]
  batches     Batch[]
  devices             Device[]
  whatsAppIntegration WhatsAppIntegration?
  createdAt           DateTime             @default(now())
  updatedAt   DateTime    @updatedAt
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  phone         String?
  passwordHash  String
  role          UserRole       @default(COUNSELLOR)
  isActive      Boolean        @default(true)
  branchId      String?
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  leads         Lead[]         @relation("CounsellorLeads")
  followUps     FollowUp[]     @relation("CounsellorFollowUps")
  admissions    Admission[]    @relation("CounsellorAdmissions")
  payments      Payment[]      @relation("PaymentCollector")
  batches       Batch[]        @relation("TrainerBatches")
  notifications Notification[]
  files         FileMetadata[]
  desktopAgents DesktopAgent[]
  devices       Device[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model EnquirySource {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String?
  isActive  Boolean  @default(true)
  leads     Lead[]
  createdAt DateTime @default(now())
}

model Lead {
  id                   String              @id @default(uuid())
  leadNumber           String              @unique
  leadType             String              @default("STANDARD")
  firstName            String
  lastName             String?
  phone                String
  whatsappNumber       String?
  email                String?
  qualification        String?
  city                 String?
  interestedCourse     String?
  branchId             String?
  branch               Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sourceId             String?
  source               EnquirySource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  assignedCounsellorId String?
  assignedCounsellor   User?               @relation("CounsellorLeads", fields: [assignedCounsellorId], references: [id], onDelete: SetNull)
  status               LeadStatus          @default(NEW)
  priority             Int                 @default(2)
  estimatedValue       Decimal?            @db.Decimal(12, 2)
  followUps            FollowUp[]
  statusHistory        LeadStatusHistory[]
  admission            Admission?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([phone])
  @@index([status])
  @@index([assignedCounsellorId])
  @@index([branchId])
}

model FollowUp {
  id             String         @id @default(uuid())
  leadId         String
  lead           Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  counsellorId   String?
  counsellor     User?          @relation("CounsellorFollowUps", fields: [counsellorId], references: [id], onDelete: SetNull)
  scheduledAt    DateTime
  completedAt    DateTime?
  type           FollowUpType   @default(CALL)
  status         FollowUpStatus @default(PENDING)
  notes          String?
  outcome        String?
  nextFollowUpAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([scheduledAt, status])
}

model LeadStatusHistory {
  id        String      @id @default(uuid())
  leadId    String
  lead      Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  oldStatus LeadStatus?
  newStatus LeadStatus
  changedBy String?
  reason    String?
  createdAt DateTime    @default(now())

  @@index([leadId, createdAt])
}

model Student {
  id                    String        @id @default(uuid())
  studentCode           String        @unique
  firstName             String
  lastName              String?
  phone                 String
  whatsappNumber        String?
  email                 String?
  dateOfBirth           DateTime?
  parentName            String?
  passportNumber        String?
  gender                String?
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  photoUrl              String?
  branchId              String?
  branch                Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  admissions            Admission[]
  attendance            Attendance[]
  certificates          Certificate[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([branchId])
}

model Course {
  id            String      @id @default(uuid())
  courseCode    String      @unique
  name          String
  description   String?
  durationDays  Int?
  durationHours Int?
  standardFee   Decimal     @db.Decimal(12, 2)
  isActive      Boolean     @default(true)
  batches       Batch[]
  admissions    Admission[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Batch {
  id         String       @id @default(uuid())
  batchCode  String       @unique
  name       String
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  trainerId  String?
  trainer    User?        @relation("TrainerBatches", fields: [trainerId], references: [id], onDelete: SetNull)
  branchId   String?
  branch     Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  startDate  DateTime
  endDate    DateTime?
  startTime  String?
  endTime    String?
  daysOfWeek String?
  capacity   Int          @default(25)
  room       String?
  mode       String?
  status     BatchStatus  @default(UPCOMING)
  admissions Admission[]
  attendance Attendance[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([courseId])
  @@index([branchId])
}

model Admission {
  id              String          @id @default(uuid())
  admissionNumber String          @unique
  leadId          String?         @unique
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  courseId        String
  course          Course          @relation(fields: [courseId], references: [id], onDelete: Restrict)
  batchId         String?
  batch           Batch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  counsellorId    String?
  counsellor      User?           @relation("CounsellorAdmissions", fields: [counsellorId], references: [id], onDelete: SetNull)
  branchId        String?
  branch          Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  admissionDate   DateTime        @default(now())
  joiningDate     DateTime?
  startDate       DateTime?
  endDate         DateTime?
  completedModules Int            @default(0)
  completionPct   Int             @default(0)
  agreedFee       Decimal         @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  finalFee        Decimal         @db.Decimal(12, 2)
  status          AdmissionStatus @default(PENDING)
  notes           String?
  installmentPlan String?
  payments        Payment[]
  attendance      Attendance[]
  certificate     Certificate?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([studentId])
  @@index([batchId])
  @@index([branchId])
}

model Payment {
  id                   String        @id @default(uuid())
  admissionId          String
  admission            Admission     @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  branchId             String?
  branch               Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  receiptNumber        String        @unique
  amount               Decimal       @db.Decimal(12, 2)
  installmentNumber    Int?          @default(1)
  paymentMethod        PaymentMethod
  transactionReference String?
  paymentDate          DateTime      @default(now())
  status               PaymentStatus @default(SUCCESS)
  remarks              String?
  notes                String?
  createdById          String?
  createdBy            User?         @relation("PaymentCollector", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime      @default(now())

  @@index([admissionId, paymentDate])
  @@index([branchId])
}

model Attendance {
  id             String           @id @default(uuid())
  studentId      String
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admissionId    String
  admission      Admission        @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  batchId        String
  batch          Batch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  attendanceDate DateTime
  status         AttendanceStatus
  checkInTime    String?
  checkOutTime   String?
  remarks        String?
  createdAt      DateTime         @default(now())

  @@unique([studentId, batchId, attendanceDate])
  @@index([batchId, attendanceDate])
}

model Certificate {
  id                String            @id @default(uuid())
  studentId         String
  student           Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admissionId       String            @unique
  admission         Admission         @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  certificateNumber String            @unique
  certificateType   String            @default("COURSE_COMPLETION")
  issueDate         DateTime?
  status            CertificateStatus @default(PENDING)
  certificateUrl    String?
  createdAt         DateTime          @default(now())
}

model Notification {
  id            String           @id @default(uuid())
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  referenceType String?
  referenceId   String?
  isRead        Boolean          @default(false)
  scheduledAt   DateTime?
  createdAt     DateTime         @default(now())

  @@index([userId, isRead])
}

model FileMetadata {
  id               String   @id @default(uuid())
  organizationId   String   @default("org_default")
  uploadedById     String?
  uploadedBy       User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  originalFilename String
  storageKey       String   @unique
  storageProvider  String   @default("SUPABASE_STORAGE")
  mimeType         String
  fileSize         Int
  category         String   @default("documents")
  recordId         String?
  publicUrl        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, category])
  @@index([uploadedById])
}

model DesktopAgent {
  id             String   @id @default(uuid())
  agentId        String   @unique
  organizationId String   @default("org_default")
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName     String
  platform       String   @default("windows")
  appVersion     String   @default("1.0.0")
  storagePath    String?
  status         String   @default("ACTIVE")
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
  @@index([userId])
}

enum DeviceRole {
  PRIMARY
  AUTHORIZED
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED
  BLOCKED
}

enum DeviceType {
  LAPTOP
  DESKTOP
  MOBILE
  TABLET
}

model Device {
  id           String       @id @default(uuid())
  deviceId     String       @unique
  deviceName   String
  deviceType   DeviceType   @default(LAPTOP)
  deviceRole   DeviceRole   @default(AUTHORIZED)
  branchId     String?
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userId       String?
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  status       DeviceStatus @default(ACTIVE)
  registeredAt DateTime     @default(now())
  lastActiveAt DateTime     @default(now())
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([deviceRole])
  @@index([branchId])
  @@index([userId])
}

model WhatsAppIntegration {
  id                   String   @id @default(uuid())
  organizationId       String   @default("org_default")
  branchId             String?  @unique
  branch               Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  wabaId               String
  phoneNumberId        String
  phoneNumber          String?
  displayPhoneNumber   String?
  businessName         String?
  accessTokenEncrypted String
  tokenMetadata        String?
  status               String   @default("CONNECTED")
  connectedAt          DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([organizationId, phoneNumberId])
  @@index([organizationId])
  @@index([branchId])
  @@index([phoneNumberId])
  @@index([wabaId])
}

